# FusionPBX server hostname or IP used in API requests (no https://)
FUSIONPBX_HOST=pbx.example.com

# The system hostname of the FusionPBX server — run `hostname` on the server to get this value.
# The fax queue service only processes records where this matches exactly; wrong value = faxes never send.
FUSIONPBX_HOSTNAME=your-fusionpbx-server-hostname

# API key: Menu > Accounts > User Manager > Edit > API Key > GENERATE
FUSIONPBX_API_KEY=your_api_key_here

# Domain UUID from FusionPBX (Menu > Accounts > Domains)
FUSIONPBX_DOMAIN_UUID=ea1699e0-3a81-4448-825f-cad1235cd650

# Fax server UUID (Menu > Fax > Fax Servers, UUID from the fax server record)
FUSIONPBX_FAX_UUID=d61da57e-d58d-4e85-ba9f-46774f9c6297

# FusionPBX username to record as the inserting user on each fax queue entry
# The script validates this user exists and resolves their UUID automatically
INSERT_USER=your_fusionpbx_username

# Email address for fax status notifications
# Best to use the email of the user using the PC that this
# script runs on, so they get notified of fax delivery status.
FUSIONPBX_FAX_EMAIL=notify@example.com

# Optional: dial prefix to prepend to fax numbers (e.g. 9 for outside line)
FUSIONPBX_FAX_PREFIX=

# Set to false to skip SSL certificate verification (use for self-signed certs)
VERIFY_SSL=true

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Set to DEBUG to log all API requests/responses and file processing details
LOG_LEVEL=INFO

# Number of days to retain log entries (default: 7)
LOG_MAX_DAYS=7

# Directory to watch for incoming PDF files named <10-digit-number>.pdf
WATCH_DIR=/path/to/watch

# Where to move successfully sent faxes (defaults to WATCH_DIR/completed)
COMPLETED_DIR=/path/to/completed

# Where to move faxes that fail validation or sending (defaults to WATCH_DIR/problem)
PROBLEM_DIR=/path/to/problem

# Log file path (defaults to WATCH_DIR/print2fax.log)
LOG_FILE=/path/to/print2fax.log
